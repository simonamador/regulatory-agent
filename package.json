{
  "name": "rqaudit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.0",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "eval": "turbo run build --filter=@rqaudit/api && node --env-file=.env apps/api/dist/evals.js",
    "start": "node apps/api/dist/server.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.13.0",
    "knip": "^6.43.0",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
